# Скопіюйте цей файл у .env. Для роботи з Ollama нічого міняти не обов'язково.

# Хто генерує відповіді: ollama (локально, безкоштовно) або claude
LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_URL=http://localhost:11434
# 8 ГБ RAM: gemma3:4b або llama3.2:3b. 16 ГБ RAM: qwen2.5:7b або llama3.1:8b
OLLAMA_MODEL=gemma3:4b
OLLAMA_NUM_CTX=8192

# --- Пошук ---
TOP_K=5
MIN_COVERAGE=0.3

# --- Claude (лише якщо LLM_PROVIDER=claude; потрібен pip install anthropic) ---
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-5-5
# PRICE_IN_PER_MTOK=0.10
# PRICE_OUT_PER_MTOK=0.50

# Папка з вашими матеріалами (за замовчуванням solution/docs)
# DOCS_DIR=C:/study/my_course
